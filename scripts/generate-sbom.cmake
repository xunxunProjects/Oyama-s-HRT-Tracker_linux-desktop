# Generate a CycloneDX 1.5 SBOM from the pinned third-party versions.
# Usage: cmake -DOUT=third_party/sbom.json -P scripts/generate-sbom.cmake
if(NOT DEFINED OUT)
    set(OUT "${CMAKE_CURRENT_LIST_DIR}/../third_party/sbom.json")
endif()
get_filename_component(OUT "${OUT}" ABSOLUTE)

include("${CMAKE_CURRENT_LIST_DIR}/../third_party/versions.cmake")

set(_keys qt6 qt5 pg sodium json xen)
set(_names qt6 qt5 postgresql libsodium nlohmann-json xen)
set(_vars QT6 QT5 PG SODIUM JSON XEN)

set(_json "{\n")
string(APPEND _json "  \"bomFormat\": \"CycloneDX\",\n")
string(APPEND _json "  \"specVersion\": \"1.5\",\n")
string(APPEND _json "  \"version\": 1,\n")
string(APPEND _json "  \"metadata\": {\n")
string(APPEND _json "    \"tools\": [\n")
string(APPEND _json "      {\n")
string(APPEND _json "        \"vendor\": \"Oyama\",\n")
string(APPEND _json "        \"name\": \"generate-sbom.cmake\",\n")
string(APPEND _json "        \"version\": \"1\"\n")
string(APPEND _json "      }\n")
string(APPEND _json "    ]\n")
string(APPEND _json "  },\n")
string(APPEND _json "  \"components\": [\n")

list(LENGTH _keys _count)
math(EXPR _last "${_count} - 1")
foreach(_i RANGE ${_last})
    list(GET _keys ${_i} _key)
    list(GET _names ${_i} _name)
    list(GET _vars ${_i} _var)
    set(_version "${OYAMA_${_var}_VERSION}")
    set(_hash "${OYAMA_${_var}_SHA256}")

    if(_version STREQUAL "" OR _hash STREQUAL "" OR _hash STREQUAL "<fill>")
        message(FATAL_ERROR
            "Dependency ${_key} is not pinned in third_party/versions.cmake")
    endif()

    string(APPEND _json "    {\n")
    string(APPEND _json "      \"type\": \"library\",\n")
    string(APPEND _json "      \"name\": \"${_name}\",\n")
    string(APPEND _json "      \"version\": \"${_version}\",\n")
    string(APPEND _json "      \"purl\": \"pkg:generic/${_name}@${_version}\",\n")
    string(APPEND _json "      \"hashes\": [\n")
    string(APPEND _json "        {\n")
    string(APPEND _json "          \"alg\": \"SHA-256\",\n")
    string(APPEND _json "          \"content\": \"${_hash}\"\n")
    string(APPEND _json "        }\n")
    string(APPEND _json "      ]\n")
    if(_i LESS _last)
        string(APPEND _json "    },\n")
    else()
        string(APPEND _json "    }\n")
    endif()
endforeach()

string(APPEND _json "  ]\n")
string(APPEND _json "}\n")

file(WRITE "${OUT}" "${_json}")
message(STATUS "Wrote SBOM: ${OUT}")
